# Copier vers .env à la racine. Valeurs locales de développement uniquement.

# Interface Vite (seules les variables VITE_ sont exposées au navigateur).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# API FastAPI.
APP_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Serveur seulement, ne jamais préfixer par VITE_ ni committer la vraie valeur.
SUPABASE_SECRET_KEY=replace-only-if-a-server-privileged-operation-is-added

# Les fournisseurs et modèles réels restent à sélectionner. Le mode mock n’appelle aucun service.
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_API_KEY=
EMBEDDING_MODEL=mock
EMBEDDING_API_KEY=

# Les limites de tokens et les budgets seront configurés après décision d’équipe.
